  install -Dm755 "${srcdir}/bin/neru" \
          "${pkgdir}/usr/bin/neru"
  mkdir -p "${pkgdir}/usr/share/man/man1/"
  for file in "${srcdir}/share/man/man1/"*; do
    if [ -f "$file" ]; then
      gzip -c "$file" > "${pkgdir}/usr/share/man/man1/$(basename $file).gz"
    fi
  done
}
